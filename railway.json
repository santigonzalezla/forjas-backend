{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "buildCommand": "pnpm build"
    },
    "deploy": {
        "preDeployCommand": ["pnpm db:deploy"],
        "startCommand": "pnpm start:prod",
        "healthcheckPath": "/api/category",
        "restartPolicyType": "ON_FAILURE"
    }
}
